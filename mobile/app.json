{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Used to record voice messages and for voice/video calls.",
        "NSCameraUsageDescription": "Used for video calls."
      }
    },
    "android": {
      "package": "com.rajankumarsingh.secretchatapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "Used to record voice messages you send in chats."
        }
      ],
      [
        "react-native-webrtc",
        {
          "cameraPermission": "Used for video calls.",
          "microphonePermission": "Used for voice and video calls."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7b9765f5-f1c7-4808-be73-c40024342002"
      }
    },
    "owner": "rajankumarsingh"
  }
}